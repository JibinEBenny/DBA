-- To list the files for a database with name , physical name, type, state, size

                            SELECT DB_NAME(database_id) AS db,
                                   name            AS logical_name,
                                   physical_name,
                                   type_desc,
                                   state_desc,
                                   size * 8 / 1024 AS size_mb
                            FROM sys.master_files
                            ORDER BY db, type_desc;

